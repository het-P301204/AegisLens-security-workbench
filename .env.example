# AegisLens configuration.
# Copy to .env and adjust. Every value below has a working default, and none of
# them are secrets - AegisLens has no authentication and no external integrations.

# Where the SQLite database file lives.
AEGISLENS_DATABASE_URL=sqlite:///./aegislens.db

# Directory holding the synthetic seed dataset.
AEGISLENS_SAMPLE_DATA_DIR=./sample-data

# Built frontend bundle to serve from the API (single-container mode).
AEGISLENS_STATIC_DIR=./frontend/dist

# Browser origins allowed to call the API, comma separated.
# Only needed when the frontend runs on a different origin than the API.
AEGISLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Load the sample dataset automatically when the database is empty.
AEGISLENS_SEED_ON_STARTUP=true

# Frontend dev server only: where `npm run dev` proxies /api requests.
VITE_API_TARGET=http://127.0.0.1:8000
